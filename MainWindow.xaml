<Window x:Class="ChristmasPoemApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Santa's Christmas Poem" Height="600" Width="900"
        Background="#F0F8FF" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Background with Christmas theme -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2C1810" Offset="0"/>
                <GradientStop Color="#4A2C1F" Offset="0.5"/>
                <GradientStop Color="#2C1810" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <!-- Snowflakes decoration -->
        <Canvas x:Name="SnowflakeCanvas" Panel.ZIndex="10" IsHitTestVisible="False">
            <!-- Snowflakes will be added programmatically -->
        </Canvas>
        
        <!-- Main content area -->
        <Border Margin="40" Background="#FFF8E7" CornerRadius="10" 
                BorderBrush="#8B4513" BorderThickness="3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.7"/>
            </Border.Effect>
            
            <Grid>
                <!-- Decorative border -->
                <Border BorderBrush="#C41E3A" BorderThickness="2" Margin="15" CornerRadius="5">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Title -->
                        <TextBlock Grid.Row="0" Text="A Christmas Message" 
                                   FontFamily="Segoe Script" FontSize="32" 
                                   FontWeight="Bold" Foreground="#C41E3A"
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <!-- Poem canvas -->
                        <Canvas Grid.Row="1" x:Name="PoemCanvas">
                            <!-- Poem text will be drawn here -->
                            <TextBlock x:Name="PoemText" 
                                       FontFamily="Segoe Script" 
                                       FontSize="22" 
                                       Foreground="#2C1810"
                                       LineHeight="35"
                                       TextWrapping="Wrap"
                                       Width="700"/>
                            
                            <!-- Animated Quill Pen (Santa's quill) -->
                            <Canvas x:Name="QuillCanvas" Canvas.Left="0" Canvas.Top="0">
                                <!-- Feather -->
                                <Path x:Name="QuillFeather" Fill="#C41E3A" Stroke="#8B0000" StrokeThickness="1">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="20,0">
                                                <BezierSegment Point1="25,5" Point2="25,10" Point3="20,15"/>
                                                <BezierSegment Point1="15,10" Point2="15,5" Point3="20,0"/>
                                            </PathFigure>
                                            <PathFigure StartPoint="20,0">
                                                <LineSegment Point="18,20"/>
                                                <LineSegment Point="22,20"/>
                                                <LineSegment Point="20,0"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                    <Path.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="2" Opacity="0.5"/>
                                    </Path.Effect>
                                </Path>
                                
                                <!-- Quill tip -->
                                <Polygon x:Name="QuillTip" Points="18,20 22,20 20,28" 
                                         Fill="#FFD700" Stroke="#8B6914" StrokeThickness="0.5"/>
                                
                                <!-- Ink sparkle effect -->
                                <Ellipse x:Name="InkSparkle" Width="8" Height="8" 
                                         Fill="#4169E1" Opacity="0.7"
                                         Canvas.Left="16" Canvas.Top="26"/>
                            </Canvas>
                        </Canvas>
                    </Grid>
                </Border>
                
                <!-- Holly decoration in corners -->
                <Canvas>
                    <!-- Top left holly -->
                    <Ellipse Canvas.Left="30" Canvas.Top="30" Width="12" Height="12" Fill="#C41E3A"/>
                    <Ellipse Canvas.Left="42" Canvas.Top="30" Width="12" Height="12" Fill="#C41E3A"/>
                    <Ellipse Canvas.Left="36" Canvas.Top="36" Width="12" Height="12" Fill="#C41E3A"/>
                    
                    <!-- Top right holly -->
                    <Ellipse Canvas.Right="30" Canvas.Top="30" Width="12" Height="12" Fill="#C41E3A"/>
                    <Ellipse Canvas.Right="42" Canvas.Top="30" Width="12" Height="12" Fill="#C41E3A"/>
                    <Ellipse Canvas.Right="36" Canvas.Top="36" Width="12" Height="12" Fill="#C41E3A"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
